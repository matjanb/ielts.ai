# ─────────────────────────────────────────────────────────
# ielts.ai — Environment Variables
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local to version control.
# ─────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to client. Used only in server-side routes.
# Find in: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Paddle (payments) ─────────────────────────────────────
# Client-side token from Paddle Dashboard → Developer tools → Authentication.
# NEXT_PUBLIC_PADDLE_ENV is 'sandbox' or 'production'.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_...
NEXT_PUBLIC_PADDLE_ENV=production

# Paddle Price IDs — create 3 prices in Paddle Catalog and paste their IDs.
#   1mo  → billed every 1 month
#   3mo  → billed every 3 months
#   12mo → billed every 12 months
NEXT_PUBLIC_PADDLE_PRICE_1MO=pri_...
NEXT_PUBLIC_PADDLE_PRICE_3MO=pri_...
NEXT_PUBLIC_PADDLE_PRICE_12MO=pri_...

# Webhook secret from Paddle → Developer tools → Notifications → your endpoint.
# Endpoint URL: https://ielts.camp/api/paddle/webhook
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# ── App URLs ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical site origin used in sitemap/SEO and absolute links.
NEXT_PUBLIC_SITE_URL=https://ielts.camp

# ── OpenAI (for AI feedback features) ────────────────────
OPENAI_API_KEY=sk-...

# ── Cloudflare Turnstile (essay-checker anti-abuse) ──────
# Keys from Cloudflare Dashboard → Turnstile. When TURNSTILE_SECRET_KEY is
# unset, captcha verification is skipped entirely (dev convenience).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# Salt for hashing anonymous essay-checker users (any long random string).
ANON_HASH_SALT=...

# ── Telegram bot (coach agent) ───────────────────────────
# Token from @BotFather; webhook secret is any long random string —
# it must match the secret_token passed to setWebhook.
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_WEBHOOK_SECRET=...

# ── Cron auth ─────────────────────────────────────────────
# Vercel cron calls /api/agent/digest with Authorization: Bearer $CRON_SECRET
CRON_SECRET=...
